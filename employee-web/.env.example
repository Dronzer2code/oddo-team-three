# Employee web app — copy to .env.local and fill in.

VITE_API_URL=http://localhost:4000
VITE_WEB_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174

# Google Maps browser key, used to draw the route on ride, booking and trip
# pages. Leave it empty and the maps report that they are unconfigured rather
# than rendering a blank grey box.
#
# Get one at https://console.cloud.google.com/google/maps-apis/credentials
# Enable "Maps JavaScript API", then restrict the key to your origins.
VITE_GOOGLE_MAPS_API_KEY=
