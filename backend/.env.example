# RideSync API — no external services required.
# The database is embedded PostgreSQL (PGlite) written to backend/.data/pgdata.

NODE_ENV=development
PORT=4000

# Change this before any real deployment.
JWT_SECRET=ridesync-dev-secret-change-me
JWT_EXPIRES_IN_SECONDS=43200

# Where the embedded database files live (relative to backend/).
DATABASE_DIR=.data/pgdata

# Allowed browser origins in production (dev allows all).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Base URL used to build invitation links.
EMPLOYEE_APP_URL=http://localhost:5175
